---
interface Props {
  title: string;
  description?: string;
  /** Drop the reading column and the footer nav so the page can fill the window. */
  bleed?: boolean;
}

const { title, description = "Aditya Palve's personal website", bleed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={{ bleed }}>
    <main>
      <slot />
    </main>
    {!bleed && (
      <nav>
        <a href="/">home</a> • 
        <a href="/village">experience</a> • 
        <a href="/writing">writing</a> • 
        <a href="/bookshelf">bookshelf</a> • 
        <a href="/footpaths">footpaths</a> • 
        <a href="/contact">contact</a>
      </nav>
    )}
  </body>
</html>

<style is:global>
  :root {
    --font-body: 'Georgia', 'Times New Roman', serif;
    --font-mono: 'SF Mono', 'Menlo', monospace;
    --color-bg: #fafafa;
    --color-text: #1a1a1a;
    --color-muted: #666;
    --color-link: #0066cc;
    --color-link-hover: #004499;
    --max-width: 640px;

    /* Motion: one strong ease-out for every UI transition */
    --ease-out: cubic-bezier(0.2, 0, 0, 1);

    /* Depth: layered shadow acts as a 1px border ring plus lift */
    --shadow-border:
      0 0 0 1px oklch(0 0 0 / 0.06),
      0 1px 2px -1px oklch(0 0 0 / 0.06),
      0 2px 4px 0 oklch(0 0 0 / 0.04);
    --shadow-border-hover:
      0 0 0 1px oklch(0 0 0 / 0.08),
      0 1px 2px -1px oklch(0 0 0 / 0.08),
      0 2px 4px 0 oklch(0 0 0 / 0.06);
    /* Image edge: pure black/white at low opacity, never a tinted neutral */
    --outline-image: oklch(0 0 0 / 0.1);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #111;
      --color-text: #e0e0e0;
      --color-muted: #888;
      --color-link: #6db3f2;
      --color-link-hover: #a8d4ff;
      --shadow-border: 0 0 0 1px oklch(1 0 0 / 0.08);
      --shadow-border-hover: 0 0 0 1px oklch(1 0 0 / 0.13);
      --outline-image: oklch(1 0 0 / 0.1);
    }
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 18px;
    line-height: 1.6;
    /* Full-bleed sections use 100vw; clip the scrollbar-width overflow */
    overflow-x: clip;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-bg);
    color: var(--color-text);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  body.bleed {
    max-width: none;
    padding: 0;
  }

  nav {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-muted);
    text-align: center;
    font-size: 0.9rem;
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
    /* High-frequency interaction: transition only color, ≤150ms */
    transition-property: color, text-decoration-color;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-out);
  }

  /* Links in content carry a quiet underline at rest: hover is not available on touch,
     so the underline cannot be the only thing that marks a link. Nav links stay bare. */
  main a {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-link), transparent 60%);
    text-underline-offset: 0.15em;
  }

  /* Gate hover behind real pointers so taps don't leave sticky hover states */
  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
      text-decoration-color: currentColor;
    }

    nav a:hover {
      color: var(--color-text);
      text-decoration: none;
    }
  }

  img {
    outline: 1px solid var(--outline-image);
    outline-offset: -1px;
  }

  h1 {
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  p {
    margin-bottom: 1rem;
  }

  ul, ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(128, 128, 128, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 3px;
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-muted);
    margin: 2rem 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  p, li {
    text-wrap: pretty;
  }

  h1, h2, h3 {
    text-wrap: balance;
  }

  /* Rendered markdown */
  .prose blockquote {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-muted);
    color: var(--color-muted);
  }

  .prose pre {
    margin-bottom: 1rem;
    padding: 1rem;
    overflow-x: auto;
    border-radius: 6px;
    background: rgba(128, 128, 128, 0.1);
    font-size: 0.85em;
    line-height: 1.5;
  }

  .prose pre code {
    padding: 0;
    background: none;
    font-size: inherit;
  }

  .prose img {
    display: block;
    margin: 1.5rem auto;
    border-radius: 4px;
  }

  .muted {
    color: var(--color-muted);
  }

  .small {
    font-size: 0.85rem;
  }
</style>
