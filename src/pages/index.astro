---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { loadFootpaths } from '../lib/footpaths';
import { formatMonthYear, isoDate } from '../lib/format';
import { loadVillage } from '../lib/village';

const posts = (await getCollection('writing'))
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const reading = (await getCollection('books')).filter((book) => book.data.status === 'reading');

const latestFootpath = loadFootpaths()[0];

const village = loadVillage();
---

<BaseLayout title="Aditya Palve">
  <h1>Aditya Palve</h1>

  <p>
    I'm a software engineer at Jaguar Land Rover and an MEng Computer Science with Innovation
    graduate from the University of Bristol.
  </p>

  <p>
    What I've built lives in a small village. Walk in, and the keeper of each hut will tell you
    about one piece of it.
  </p>

  <figure class="village">
    <a class="window" href="/village" aria-label="Walk into the village">
      <canvas class="postcard" aria-hidden="true"></canvas>
      <span class="enter label"><span aria-hidden="true">▶</span> Walk in</span>
    </a>
    <figcaption class="village-foot">
      <span class="label muted">{village.huts.length} huts · 1 workshop</span>
      <a class="label skip" href="/experience">Skip to the list <span aria-hidden="true">▸▸</span></a>
    </figcaption>
  </figure>

  <p>
    Away from work I read, walk, and photograph the places I end up in. Those turn into the
    <a href="/bookshelf">bookshelf</a> and <a href="/footpaths">footpaths</a> here.
  </p>

  <hr />

  <h2>Writing</h2>

  <ul class="plain-list">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.id}`}>{post.data.title}</a>
        <span class="muted small"> — <time datetime={isoDate(post.data.date)}>{formatMonthYear(post.data.date)}</time></span>
      </li>
    ))}
  </ul>

  <p class="small muted">
    All posts on the <a href="/writing">writing</a> page.
  </p>

  {reading.length > 0 && (
    <>
      <h2>Currently reading</h2>
      <ul class="plain-list">
        {reading.map((book) => (
          <li>
            <em>{book.data.title}</em>
            <span class="muted small"> — {book.data.author}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  {latestFootpath && (
    <>
      <h2>Latest footpath</h2>
      <p>
        <a href="/footpaths">{latestFootpath.location}</a>
        <span class="muted small"> — <time datetime={latestFootpath.date}>{latestFootpath.date}</time></span>
      </p>
    </>
  )}

  <script is:inline type="application/json" id="village-data" set:html={JSON.stringify(village)} />
</BaseLayout>

<style>
  .label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .village {
    margin-block: 1.75rem 2rem;
  }

  /* A window onto the village, framed like the footpaths map */
  .window {
    position: relative;
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: #1d1a1f;
    box-shadow: var(--shadow-border);
    transition: box-shadow 150ms var(--ease-out);
  }

  .window:focus-visible {
    outline: 3px solid var(--color-link);
    outline-offset: 2px;
  }

  .postcard {
    display: block;
    image-rendering: pixelated;
  }

  /* The same start gate the game uses, so the click lands where you expect */
  .enter {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: 0.55rem 0.9rem;
    border-radius: 4px;
    background: rgba(29, 26, 31, 0.78);
    color: #fff;
    white-space: nowrap;
    transition-property: background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-out);
  }

  .window:active .enter {
    scale: 0.96;
  }

  .village-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
  }

  .skip {
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .window:hover {
      box-shadow: var(--shadow-border-hover);
    }

    .window:hover .enter {
      background: var(--color-link);
    }

    .skip:hover {
      text-decoration: none;
    }
  }

  @media (max-width: 560px) {
    .window {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .window:active .enter {
      scale: 1;
    }
  }

  .plain-list {
    list-style: none;
    padding-left: 0;
  }

  .plain-list li {
    margin-bottom: 0.75rem;
  }
</style>

<script>
  import type { VillageData } from '../scripts/village/map';
  import { startPostcard } from '../scripts/village/postcard';

  const frame = document.querySelector<HTMLElement>('.window');

  const canvas = document.querySelector<HTMLCanvasElement>('.postcard');

  const raw = document.getElementById('village-data')?.textContent;

  if (frame !== null && canvas !== null && raw !== undefined && raw !== null) {
    const data: VillageData = JSON.parse(raw);

    startPostcard(canvas, frame, data);
  }
</script>
