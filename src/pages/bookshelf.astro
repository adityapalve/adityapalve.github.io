---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { groupByYear, hasNotes, spineStyle } from '../lib/books';

const shelves = groupByYear(await getCollection('books'));

const statusLabel = { reading: 'reading', finished: 'finished', abandoned: 'set aside' };
---

<BaseLayout title="Bookshelf – Aditya Palve">
  <h1>Bookshelf</h1>

  <p class="muted">
    Books I've read, stacked by the year I finished them. Click a book to pick it up; a ring on the spine means I wrote notes.
  </p>

  <section class="shelf" aria-label="Books by year">
    {[...shelves].map(([year, books]) => (
      <div class="shelf-year">
        <span class="shelf-label">{year}</span>
        <ul class="stack">
          {books.map((book, index) => (
            <li class="book-slot" style={`${spineStyle(book)} --i: ${index};`}>
              <div class="scene">
                <button
                  type="button"
                  class="book"
                  id={`book-${book.id}`}
                  aria-expanded="false"
                  aria-controls={`details-${book.id}`}
                >
                  <span class="face top" aria-hidden="true"></span>
                  <span class="face spine">
                    <span class="spine-author">{book.data.author}</span>
                    <span class="spine-title">{book.data.title}</span>
                    {hasNotes(book) ? (
                      <span class="spine-mark" aria-hidden="true"></span>
                    ) : book.data.status === 'reading' ? (
                      <span class="spine-status">reading</span>
                    ) : (
                      <span class="spine-mark spine-mark-empty" aria-hidden="true"></span>
                    )}
                  </span>
                </button>
              </div>

              <div class="book-details" id={`details-${book.id}`} role="region" aria-labelledby={`book-${book.id}`}>
                <div class="book-details-clip">
                  <div class="book-details-content">
                    <p class="muted small book-meta">
                      {book.data.author} · {statusLabel[book.data.status]} {year}
                      {book.data.pages && ` · ${book.data.pages} pages`}
                    </p>
                    {book.data.description && <p class="book-description">{book.data.description}</p>}
                    {hasNotes(book) && (
                      <a class="notes-link" href={`/bookshelf/${book.id}`}>Read my notes →</a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .shelf {
    margin-block: 2.5rem 3rem;
    --book-depth: 72px;
  }

  .shelf-year {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .shelf-year:last-child {
    margin-bottom: 0;
  }

  .shelf-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    padding-top: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Books higher in the stack paint over the top faces of the ones below them */
  .book-slot {
    position: relative;
    z-index: calc(100 - var(--i));
    margin: 0;
  }

  /* Each book gets its own camera so the tilt reads the same all the way down the page */
  .scene {
    perspective: 900px;
    perspective-origin: 50% 50%;
    display: flex;
    justify-content: center;
  }

  .book {
    position: relative;
    width: var(--spine-length);
    height: var(--spine-thickness);
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 255, 255, 0.92);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transform-style: preserve-3d;
    /* `translate` and `scale` stay free for hover/press while the scroll animation owns `transform` */
    transition-property: translate, scale;
    transition-duration: 200ms;
    transition-timing-function: var(--ease-out);
  }

  .face {
    position: absolute;
    left: 0;
    right: 0;
  }

  .spine {
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
    align-items: center;
    gap: 1rem;
    padding-inline: 1.25rem;
    background: var(--spine-color);
    border-radius: 3px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 14px 28px -16px rgba(0, 0, 0, 0.6);
    font-size: 0.8rem;
    line-height: 1.2;
  }

  /* The front cover, lying flat behind the spine; visible only because the book is tilted */
  .top {
    bottom: 100%;
    height: var(--book-depth);
    transform-origin: bottom center;
    transform: rotateX(90deg);
    background: color-mix(in oklab, var(--spine-color), white 18%);
    border-radius: 3px 3px 0 0;
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.14);
  }

  /* Scroll-driven tilt: nearly edge-on as a book enters at the bottom, seen from above by the time it leaves */
  @keyframes book-tilt {
    from {
      transform: rotateX(3deg);
    }

    to {
      transform: rotateX(28deg);
    }
  }

  @supports (animation-timeline: view()) {
    .book {
      animation: book-tilt linear both;
      animation-timeline: view();
    }
  }

  @supports not (animation-timeline: view()) {
    .book {
      transform: rotateX(14deg);
    }
  }

  .spine-author {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.75;
    line-height: 1.25;
  }

  .spine-title {
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .spine-mark {
    justify-self: end;
    width: 10px;
    height: 10px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    opacity: 0.8;
  }

  .spine-mark-empty {
    visibility: hidden;
  }

  .spine-status {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    opacity: 0.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .book:hover {
      translate: 0 -2px 18px;
    }
  }

  .book:active {
    scale: 0.96;
  }

  .book:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 4px;
  }

  /* Picked up: sits proud of the stack while its details are open */
  .book-slot[data-open] .book {
    translate: 0 -2px 26px;
  }

  /* Details unfold beneath the spine; grid rows interpolate 0fr → 1fr so height needs no JS */
  .book-details {
    display: grid;
    grid-template-rows: 0fr;
    width: var(--spine-length);
    margin: 0 auto;
    transition: grid-template-rows 150ms var(--ease-out);
  }

  .book-details-clip {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    translate: 0 -6px;
    transition-property: opacity, translate;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-out);
  }

  .book-details-content {
    padding: 0.85rem 0.25rem 0.25rem;
  }

  .book-slot[data-open] .book-details {
    grid-template-rows: 1fr;
    transition-duration: 200ms;
  }

  .book-slot[data-open] .book-details-clip {
    opacity: 1;
    translate: 0;
    transition-duration: 200ms;
  }

  .book-meta {
    margin-bottom: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .book-description {
    margin-bottom: 0.5rem;
  }

  .notes-link {
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .book {
      animation: none;
      transform: rotateX(12deg);
    }

    .book:hover,
    .book:active,
    .book-slot[data-open] .book {
      translate: 0;
      scale: 1;
    }

    .book-details,
    .book-details-clip {
      transition-duration: 0ms;
    }
  }

  @media (max-width: 480px) {
    .shelf-year {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .spine {
      grid-template-columns: minmax(0, 1fr) auto;
      padding-inline: 1rem;
    }

    .spine-author {
      display: none;
    }
  }
</style>

<script>
  const slots = [...document.querySelectorAll<HTMLLIElement>('.book-slot')];

  const closeAll = () => {
    for (const slot of slots) {
      delete slot.dataset.open;
      slot.querySelector('.book')?.setAttribute('aria-expanded', 'false');
    }
  };

  for (const slot of slots) {
    const book = slot.querySelector<HTMLButtonElement>('.book');

    if (book === null) continue;

    book.addEventListener('click', () => {
      const wasOpen = 'open' in slot.dataset;

      closeAll();

      if (wasOpen) return;

      slot.dataset.open = '';
      book.setAttribute('aria-expanded', 'true');
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });
</script>
