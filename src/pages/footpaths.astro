---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { loadFootpaths } from '../lib/footpaths';

// Every photo under src/assets/footpaths, keyed by absolute source path
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/footpaths/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
);

type Photo = { src: string; width: number; height: number; caption: string };

type Place = { id: string; location: string; lat: number; lng: number; date: string; photos: Photo[] };

const places: Place[] = [];

for (const footpath of loadFootpaths()) {
  const photos: Photo[] = [];

  for (const photo of footpath.photos) {
    const load = photoModules[`/src/assets/footpaths/${photo.file}`];

    if (load === undefined) continue;

    const { default: metadata } = await load();
    const image = await getImage({ src: metadata, width: 1400, format: 'webp' });

    photos.push({
      src: image.src,
      width: image.attributes.width,
      height: image.attributes.height,
      caption: photo.caption,
    });
  }

  places.push({ ...footpath, photos });
}

const hasPlaces = places.length > 0;
---

<BaseLayout title="Footpaths – Aditya Palve">
  <h1>Footpaths</h1>

  <p class="muted">Places I've wandered. Click a marker to see photos from that location.</p>

  {hasPlaces ? (
    <div id="map-container">
      <div id="map" aria-label="Map of places"></div>
    </div>
  ) : (
    <p class="empty muted small">
      No footpaths yet. Photos dropped into <code>src/assets/footpaths/&lt;place&gt;/</code> show up here on the next build.
    </p>
  )}

  <dialog id="photo-dialog" class="photo-dialog">
    <button class="dialog-close" aria-label="Close" type="button">&times;</button>
    <header class="dialog-header">
      <h3 id="dialog-location"></h3>
      <time id="dialog-date" class="muted small"></time>
    </header>
    <div id="dialog-photos" class="dialog-photos"></div>
  </dialog>

  {hasPlaces && (
    <>
      <hr />

      <h2>Location List</h2>
      <ul class="location-list">
        {places.map((place) => (
          <li>
            <time class="date muted small" datetime={place.date}>{place.date}</time>
            <button class="location-link" data-id={place.id} type="button">{place.location}</button>
            <span class="muted small">— {place.photos.length} photo{place.photos.length !== 1 ? 's' : ''}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <hr />

  <p class="muted small">
    <strong>How this works:</strong> photos go into a folder in the repo, a build step reads the GPS
    coordinates and dates from their EXIF data, and that powers the map. The published images are
    re-encoded, so no location metadata ships with them.
  </p>

  <script is:inline type="application/json" id="footpaths-data" set:html={JSON.stringify(places)} />
</BaseLayout>

<style>
  #map-container {
    margin: 1.5rem 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-border);
  }

  #map {
    width: 100%;
    height: 400px;
    background: #e0e0e0;
  }

  .empty {
    margin: 1.5rem 0;
  }

  .location-list {
    list-style: none;
    padding-left: 0;
  }

  .location-list li {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .location-list .date {
    min-width: 90px;
    font-variant-numeric: tabular-nums;
  }

  .location-link {
    background: none;
    border: none;
    color: var(--color-link);
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    padding: 0;
    text-decoration: none;
    transition-property: color, scale;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-out);
  }

  /* Press feedback: always 0.96, interruptible via transition */
  .location-link:active,
  .dialog-close:active {
    scale: 0.96;
  }

  /* Native dialog: focus trap, Escape, and inert background for free */
  .photo-dialog {
    background: var(--color-bg);
    color: var(--color-text);
    border: none;
    border-radius: 8px;
    max-width: 600px;
    width: calc(100% - 2rem);
    max-height: 90vh;
    padding: 1.5rem;
    box-shadow: var(--shadow-border);
    /* Exit: 150ms, softer than enter. display/overlay wait for the fade via allow-discrete. */
    opacity: 0;
    scale: 0.95;
    transition:
      opacity 150ms var(--ease-out),
      scale 150ms var(--ease-out),
      display 150ms allow-discrete,
      overlay 150ms allow-discrete;
  }

  .photo-dialog[open] {
    opacity: 1;
    scale: 1;
    transition-duration: 200ms;

    @starting-style {
      opacity: 0;
      scale: 0.95;
    }
  }

  .photo-dialog::backdrop {
    background: rgba(0, 0, 0, 0.8);
    opacity: 0;
    transition:
      opacity 150ms var(--ease-out),
      display 150ms allow-discrete,
      overlay 150ms allow-discrete;
  }

  .photo-dialog[open]::backdrop {
    opacity: 1;
    transition-duration: 200ms;

    @starting-style {
      opacity: 0;
    }
  }

  /* Keyboard-initiated close (Escape) gets no animation */
  .photo-dialog[data-instant],
  .photo-dialog[data-instant]::backdrop {
    transition-duration: 0ms;
  }

  .dialog-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-muted);
    line-height: 1;
    transition-property: color, scale;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-out);
  }

  .dialog-header {
    margin-bottom: 1rem;
  }

  .dialog-header h3 {
    margin: 0;
  }

  .dialog-photos {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Rendered by the script below, so these live outside Astro's scoping */
  .dialog-photos :global(figure) {
    margin: 0;
  }

  .dialog-photos :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .dialog-photos :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .location-link:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    .dialog-close:hover {
      color: var(--color-text);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Keep the opacity fade, drop the movement */
    .photo-dialog,
    .photo-dialog[open] {
      scale: 1;
      transition-property: opacity, display, overlay;
    }

    .location-link:active,
    .dialog-close:active {
      scale: 1;
    }
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Photo = { src: string; width: number; height: number; caption: string };

  type Place = { id: string; location: string; lat: number; lng: number; date: string; photos: Photo[] };

  const places: Place[] = JSON.parse(document.getElementById('footpaths-data')?.textContent ?? '[]');

  const dialog = document.querySelector<HTMLDialogElement>('#photo-dialog');

  const dialogLocation = document.querySelector<HTMLElement>('#dialog-location');

  const dialogDate = document.querySelector<HTMLTimeElement>('#dialog-date');

  const dialogPhotos = document.querySelector<HTMLElement>('#dialog-photos');

  if (dialog === null || dialogLocation === null || dialogDate === null || dialogPhotos === null) {
    throw new Error('footpaths: dialog markup is missing');
  }

  function photoFigure(photo: Photo): HTMLElement {
    const figure = document.createElement('figure');
    const img = document.createElement('img');
    const caption = document.createElement('figcaption');

    img.src = photo.src;
    img.width = photo.width;
    img.height = photo.height;
    img.alt = photo.caption;
    img.loading = 'lazy';
    caption.textContent = photo.caption;
    figure.append(img, caption);

    return figure;
  }

  // Arrow function, not a declaration, so the null checks above narrow inside it
  const openPlace = (place: Place) => {
    dialogLocation.textContent = place.location;
    dialogDate.textContent = place.date;
    dialogDate.dateTime = place.date;
    dialogPhotos.replaceChildren(...place.photos.map(photoFigure));
    delete dialog.dataset.instant;
    dialog.showModal();
  };

  dialog.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());

  // Keyboard-initiated close skips the exit animation. `cancel` covers the browser's own
  // Escape handling; the keydown listener covers it when focus sits outside the dialog.
  const closeInstantly = () => {
    dialog.dataset.instant = '';
    dialog.close();
  };

  dialog.addEventListener('cancel', () => {
    dialog.dataset.instant = '';
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !dialog.open) return;

    event.preventDefault();
    closeInstantly();
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  const mapElement = document.getElementById('map');

  if (mapElement !== null && places.length > 0) {
    const map = L.map(mapElement, { scrollWheelZoom: false });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(map);

    const markers = new Map<string, L.CircleMarker>();

    for (const place of places) {
      const marker = L.circleMarker([place.lat, place.lng], {
        radius: 7,
        color: '#fff',
        weight: 2,
        fillColor: '#0066cc',
        fillOpacity: 0.9,
      })
        .addTo(map)
        .bindTooltip(place.location);

      marker.on('click', () => openPlace(place));
      markers.set(place.id, marker);
    }

    map.fitBounds(L.latLngBounds(places.map((place) => [place.lat, place.lng])), { padding: [30, 30], maxZoom: 12 });

    for (const button of document.querySelectorAll<HTMLButtonElement>('.location-link')) {
      button.addEventListener('click', () => {
        const place = places.find((candidate) => candidate.id === button.dataset.id);

        if (place === undefined) return;

        map.setView([place.lat, place.lng], 12);
        openPlace(place);
      });
    }
  }
</script>
