{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "palve-dev",
  "main": "worker/index.ts",
  // The workers.dev URL is kept as a preview/rollback target, beside the custom domain.
  "workers_dev": true,
  // Latest date accepted by the installed workerd runtime (UTC).
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/village/room"]
  },
  "routes": [
    { "pattern": "palve.dev", "custom_domain": true },
    { "pattern": "www.palve.dev", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VILLAGE", "class_name": "VillageRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VillageRoom"] }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
